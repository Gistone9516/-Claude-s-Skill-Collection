{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/cmd/git.exe\" -C \"<CLAUDE_HOME>\" pull --ff-only -q",
            "timeout": 30,
            "statusMessage": "Pulling global config repo"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CLAUDE_HOME>/scripts/check-manifest.ps1\" -Event SessionStart",
            "timeout": 20,
            "statusMessage": "Checking global config manifest"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CLAUDE_HOME>/scripts/machine-rules.ps1\" -Event SessionStart",
            "timeout": 15,
            "statusMessage": "Loading this machine's rules"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<CLAUDE_HOME>/hooks/caveman-activate.js\"",
            "timeout": 30,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/skill-gate.sh\" reset",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<CLAUDE_HOME>/hooks/caveman-mode-tracker.js\"",
            "timeout": 30,
            "statusMessage": "Tracking caveman mode..."
          },
          {
            "type": "command",
            "command": "python -I \"<CLAUDE_HOME>/scripts/recall-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/pattern-guard.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/brief-nudge.sh\" check",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Agent|Task|Workflow|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/skill-gate.sh\" check",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CLAUDE_HOME>/scripts/guard.ps1\" -Event PostToolUse",
            "timeout": 15,
            "asyncRewake": true,
            "rewakeSummary": "guard: file written with a known-bad byte pattern",
            "rewakeMessage": "A guard hook found a defect in a file just written. Fix it before continuing: "
          },
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/brief-nudge.sh\" record",
            "shell": "bash",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/manifest-nudge.sh\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CLAUDE_HOME>/scripts/guard.ps1\" -Event PostToolUse",
            "if": "Bash(git *)",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CLAUDE_HOME>/scripts/guard.ps1\" -Event PostToolUse",
            "if": "PowerShell(git *)",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"<CLAUDE_HOME>/scripts/skill-gate.sh\" record",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"<CLAUDE_HOME>/scripts/guard.ps1\" -Event PostToolUseFailure",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
