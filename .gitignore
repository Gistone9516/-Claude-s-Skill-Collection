# Allowlist: track only sync-worthy config; everything else ignored.
# What is tracked here is exactly what manifest.json declares, so a clone
# plus the hook wiring copied out of settings.hooks.example.json reproduces
# a working install.
/*
!/.gitignore
!/README.md
!/CLAUDE.md
!/GUIDE.ko.md
!/manifest.json
!/settings.hooks.example.json
!/skills/
!/scripts/

# Global memory for the home-directory scope. Re-included level by level,
# because git cannot re-include a file whose parent directory is excluded.
!/projects/
/projects/*
!/projects/C--Users-USER/
/projects/C--Users-USER/*
!/projects/C--Users-USER/memory/

# never sync these even if rules change
.credentials.json
# settings.json is deliberately excluded, not merely un-allowlisted: it carries
# machine-absolute hook paths and this install's permission posture, and the repo
# is public. The portable part is the hooks block, published as
# settings.hooks.example.json. Decided 2026-08-10.
settings.json
settings.local.json
sessions/
session-env/
cache/
paste-cache/
shell-snapshots/
telemetry/
debug/
file-history/
history.jsonl
